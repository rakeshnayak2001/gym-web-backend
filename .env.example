# Copy to .env and fill in. Never commit .env.
PORT=8000
NODE_ENV=development

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/kinetiq

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Comma-separated allowed frontend origins (unset = allow all)
CORS_ORIGINS=http://localhost:5173

# Google Gemini (server-side only — never expose to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
